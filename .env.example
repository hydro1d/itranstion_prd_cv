# ==============================================================================
# CV Platform - Production Environment Configuration
# ==============================================================================

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production

# Internal Listening Port (Standard for Railway, Render, Fly.io, Container Apps)
ASPNETCORE_HTTP_PORTS=8080

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection
# ------------------------------------------------------------------------------
# Format 1 (Standard Cloud URI - auto-provided by Railway, Render, Supabase, Neon):
DATABASE_URL=postgresql://postgres:your_password@your_host:5432/cv_platform_db?sslmode=require

# Format 2 (Standard ASP.NET Connection String key):
# ConnectionStrings__DefaultConnection=Host=your_host;Port=5432;Database=cv_platform_db;Username=postgres;Password=your_password;Ssl Mode=Require;Trust Server Certificate=true;

# (Note: If no database is attached, the application automatically runs in Dual-Persistence
# mode with pre-seeded in-memory demo data for instant evaluation!)
