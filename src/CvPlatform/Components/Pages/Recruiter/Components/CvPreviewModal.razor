@using CvPlatform.Data.Entities
@using CvPlatform.Data.Enums
@using Markdig
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Navigation

@if (IsOpen && Cv != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6); backdrop-filter: blur(3px); z-index: 1055;">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content shadow border">
                <div class="modal-header border-bottom bg-light">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-file-earmark-person-fill text-primary fs-4"></i>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">@Cv.Title</h5>
                            <span class="text-muted small">
                                Applied for <strong class="text-body">@(Cv.Position?.Title ?? "Position")</strong> at <strong class="text-body">@(Cv.Position?.Company ?? "Company")</strong>
                            </span>
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseAsync" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <!-- Candidate Bio Bar -->
                    <div class="card border bg-body-tertiary mb-4">
                        <div class="card-body p-3">
                            <div class="row align-items-center g-3">
                                <div class="col-auto">
                                    <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold fs-4 border" style="width: 60px; height: 60px;">
                                        @GetInitials(Cv.CandidateProfile?.FullName)
                                    </div>
                                </div>
                                <div class="col">
                                    <h4 class="fw-bold mb-0">@(Cv.CandidateProfile?.FullName ?? "Candidate")</h4>
                                    <div class="text-primary fw-semibold small mb-1">
                                        @(Cv.CandidateProfile?.Headline ?? "Professional Candidate")
                                    </div>
                                    <div class="d-flex flex-wrap gap-3 small text-muted">
                                        @if (!string.IsNullOrEmpty(Cv.CandidateProfile?.Location))
                                        {
                                            <span><i class="bi bi-geo-alt me-1"></i> @Cv.CandidateProfile.Location</span>
                                        }
                                        @if (!string.IsNullOrEmpty(Cv.CandidateProfile?.Phone))
                                        {
                                            <span><i class="bi bi-telephone me-1"></i> @Cv.CandidateProfile.Phone</span>
                                        }
                                        <span><i class="bi bi-calendar3 me-1"></i> Submitted @Cv.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                                <div class="col-auto text-end">
                                    <div class="d-flex align-items-center gap-2 mb-1 justify-content-end">
                                        <span class="small fw-semibold text-muted">Match Readiness:</span>
                                        <span class="badge @(Cv.CompletionPercentage == 100 ? "bg-success" : (Cv.CompletionPercentage >= 80 ? "bg-primary" : "bg-warning")) fs-6">
                                            @Cv.CompletionPercentage%
                                        </span>
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-heart-fill text-danger me-1"></i> @(Cv.Likes?.Count ?? 0) recruiter endorsements
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Professional Summary -->
                    @if (!string.IsNullOrWhiteSpace(Cv.ProfessionalSummary))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-uppercase text-secondary small mb-2" style="letter-spacing: 0.05em;">
                                <i class="bi bi-person-lines-fill text-primary me-2"></i> Professional Summary
                            </h6>
                            <div class="p-3 border rounded bg-light">
                                <p class="mb-0 text-muted" style="white-space: pre-line;">@Cv.ProfessionalSummary</p>
                            </div>
                        </div>
                    }

                    <!-- Targeted Qualifications -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-uppercase text-secondary small mb-2" style="letter-spacing: 0.05em;">
                            <i class="bi bi-patch-check-fill text-primary me-2"></i> Targeted Qualifications & Requirements
                        </h6>
                        <div class="table-responsive border rounded">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Requirement / Attribute</th>
                                        <th style="width: 130px;">Data Type</th>
                                        <th style="width: 100px;">Status</th>
                                        <th>Candidate's Provided Qualification</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Cv.AttributeValues.Any())
                                    {
                                        @foreach (var val in Cv.AttributeValues)
                                        {
                                            var isReq = Cv.Position?.PositionAttributes.FirstOrDefault(pa => pa.AttributeId == val.AttributeId)?.IsRequired ?? false;
                                            var hasVal = !string.IsNullOrWhiteSpace(val.Value);

                                            <tr>
                                                <td>
                                                    <div class="fw-bold">@(val.Attribute?.Name ?? $"Attribute #{val.AttributeId}")</div>
                                                    <div class="text-muted small" style="font-size: 0.72rem;">@(val.Attribute?.Category?.Name ?? "General")</div>
                                                </td>
                                                <td>
                                                    <span class="badge-type @GetBadgeClass(val.Attribute?.DataType ?? AttributeDataType.Text)">
                                                        @(val.Attribute?.DataType ?? AttributeDataType.Text)
                                                    </span>
                                                </td>
                                                <td>
                                                    @if (isReq)
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">Required</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">Optional</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (hasVal)
                                                    {
                                                        if (val.Attribute?.DataType == AttributeDataType.Url)
                                                        {
                                                            <a href="@val.Value" target="_blank" class="text-primary text-decoration-none">
                                                                @val.Value <i class="bi bi-box-arrow-up-right ms-1"></i>
                                                            </a>
                                                        }
                                                        else if (val.Attribute?.DataType == AttributeDataType.Boolean)
                                                        {
                                                            <span class="badge @(val.Value == "true" ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                                                @(val.Value == "true" ? "Yes / Confirmed" : "No")
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="fw-semibold text-body">@val.Value</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger text-white">Missing Information</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center py-3 text-muted">
                                                No attribute values mapped for this CV.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Portfolio Projects Showcase -->
                    @if (Cv.CandidateProfile?.Projects?.Any() == true)
                    {
                        <div class="mb-2">
                            <h6 class="fw-bold text-uppercase text-secondary small mb-2" style="letter-spacing: 0.05em;">
                                <i class="bi bi-folder-fill text-primary me-2"></i> Portfolio Projects Showcase
                            </h6>
                            <div class="row g-3">
                                @foreach (var proj in Cv.CandidateProfile.Projects.OrderBy(p => p.DisplayOrder))
                                {
                                    <div class="col-12">
                                        <div class="p-3 border rounded bg-light">
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <h6 class="fw-bold text-primary mb-0">@proj.Title</h6>
                                                <div class="d-flex gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(proj.GitHubUrl))
                                                    {
                                                        <a href="@proj.GitHubUrl" target="_blank" class="text-muted small text-decoration-none">
                                                            <i class="bi bi-github me-1"></i> Code Repository
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(proj.ProjectUrl))
                                                    {
                                                        <a href="@proj.ProjectUrl" target="_blank" class="text-primary small text-decoration-none">
                                                            <i class="bi bi-box-arrow-up-right me-1"></i> Live Demo
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                            <p class="text-muted small mb-2">@proj.Description</p>

                                            @if (!string.IsNullOrWhiteSpace(proj.Technologies))
                                            {
                                                <div class="d-flex flex-wrap gap-1 mb-2">
                                                    @foreach (var t in proj.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                    {
                                                        <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.72rem;">@t</span>
                                                    }
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(proj.MarkdownContent))
                                            {
                                                <div class="p-2 border rounded bg-body-tertiary small text-muted markdown-rendered mt-2">
                                                    @RenderMarkdown(proj.MarkdownContent)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer border-top bg-light d-flex justify-content-between">
                    <div>
                        <button type="button" class="btn @(HasLiked ? "btn-danger" : "btn-outline-danger") btn-sm"
                                @onclick="ToggleLikeAsync">
                            <i class="bi @(HasLiked ? "bi-heart-fill" : "bi-heart") me-1"></i>
                            @(HasLiked ? "Endorsed (Liked)" : "Endorse Candidate")
                        </button>
                        <span class="text-muted small ms-2" style="font-size: 0.75rem;">
                            Strict Rule: 1 like per recruiter enforced
                        </span>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="cv/@Cv.Id" target="_blank" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-box-arrow-up-right me-1"></i> Open Document View
                        </a>
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CloseAsync">
                            @Loc["Btn_Close"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public CV? Cv { get; set; }
    [Parameter] public bool HasLiked { get; set; }
    [Parameter] public EventCallback<int> OnToggleLike { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private async Task ToggleLikeAsync()
    {
        if (Cv != null)
        {
            await OnToggleLike.InvokeAsync(Cv.Id);
        }
    }

    private async Task CloseAsync()
    {
        await OnClose.InvokeAsync();
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "CP";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetBadgeClass(AttributeDataType type) => type switch
    {
        AttributeDataType.Text => "badge-type-text",
        AttributeDataType.LongText => "badge-type-longtext",
        AttributeDataType.Number => "badge-type-number",
        AttributeDataType.Date => "badge-type-date",
        AttributeDataType.Boolean => "badge-type-boolean",
        AttributeDataType.Dropdown => "badge-type-dropdown",
        AttributeDataType.MultiSelect => "badge-type-multiselect",
        AttributeDataType.Url => "badge-type-url",
        _ => "badge-type-text"
    };

    private MarkupString RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return new MarkupString("");
        var html = Markdown.ToHtml(markdown, _pipeline);
        return new MarkupString(html);
    }
}
