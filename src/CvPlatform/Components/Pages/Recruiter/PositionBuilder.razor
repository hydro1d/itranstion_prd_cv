@page "/recruiter/positions/create"
@page "/recruiter/positions/edit/{Id:int}"
@attribute [Authorize(Roles = $"{ApplicationRole.Recruiter},{ApplicationRole.Administrator}")]
@inject IPositionService PositionService
@inject IAttributeService AttributeService
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims

<PageTitle>@(Id.HasValue ? Loc["Pos_EditTemplate"] : Loc["Pos_CreateOpening"]) - @Loc["App_Title"]</PageTitle>

<div class="mb-4">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a href="recruiter/positions" class="text-muted small text-decoration-none d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> Back to Positions
                </a>
                <span class="text-muted small">•</span>
                <span class="badge bg-primary-subtle text-primary">Structured Qualifications</span>
            </div>
            <h2 class="fw-bold mb-0">@(Id.HasValue ? Loc["Pos_EditTemplate"] : Loc["Pos_CreateOpening"])</h2>
        </div>

        <div class="d-flex gap-2">
            <a href="recruiter/positions" class="btn btn-outline-custom btn-sm">
                @Loc["Btn_Cancel"]
            </a>
            <button class="btn btn-primary btn-sm" @onclick="SavePosition">
                <i class="bi bi-check2 me-1"></i> @(Id.HasValue ? Loc["Btn_UpdateTemplate"] : Loc["Btn_PublishOpening"])
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger py-2 small mb-3">
            <i class="bi bi-exclamation-triangle me-1"></i> @errorMessage
        </div>
    }

    <div class="row g-4">
        <!-- Left: Core Position Information -->
        <div class="col-lg-7">
            <div class="app-surface p-4 mb-4">
                <h5 class="fw-semibold mb-3 d-flex align-items-center text-body">
                    <i class="bi bi-card-text text-primary me-2"></i>
                    Core Opening Details
                </h5>

                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Job Title *</label>
                        <input type="text" class="form-control" placeholder="e.g. Senior .NET Cloud Architect" @bind="positionModel.Title" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Company Name *</label>
                        <input type="text" class="form-control" placeholder="e.g. FinTech Global Solutions" @bind="positionModel.Company" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Location *</label>
                        <input type="text" class="form-control" placeholder="e.g. Stockholm, Sweden / Remote" @bind="positionModel.Location" required />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Employment Type</label>
                        <select class="form-select" @bind="positionModel.EmploymentType">
                            <option value="@EmploymentType.FullTime">Full-time</option>
                            <option value="@EmploymentType.PartTime">Part-time</option>
                            <option value="@EmploymentType.Contract">Contract</option>
                            <option value="@EmploymentType.Remote">Remote</option>
                            <option value="@EmploymentType.Internship">Internship</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Visibility Status</label>
                        <select class="form-select" @bind="positionModel.Visibility">
                            <option value="@PositionVisibility.Public">Public (Live on Portal)</option>
                            <option value="@PositionVisibility.Draft">Draft (Saved only)</option>
                            <option value="@PositionVisibility.Closed">Closed (Archived)</option>
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Application Deadline</label>
                        <input type="date" class="form-control" @bind="positionModel.Deadline" />
                    </div>

                    <div class="col-12">
                        <label class="form-label">Search Tags / Keywords</label>
                        <input type="text" class="form-control" placeholder="e.g. C#, .NET 9, Cloud, Microservices, Kubernetes" @bind="positionModel.Tags" />
                        <div class="text-muted" style="font-size: 0.72rem;">Comma-separated tags for candidate search discovery</div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Job Description *</label>
                        <textarea class="form-control" rows="6" placeholder="Describe the mission, role responsibilities, tech stack, and benefits..." @bind="positionModel.Description" required></textarea>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Customizable Attribute Template Composer -->
        <div class="col-lg-5">
            <div class="app-surface p-4 sticky-top" style="top: 5rem; z-index: 10;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-semibold mb-0 d-flex align-items-center text-body">
                        <i class="bi bi-sliders2 text-primary me-2"></i>
                        Requirement Template
                    </h5>
                    <span class="badge bg-primary-subtle text-primary">Template Builder</span>
                </div>
                <p class="text-muted small mb-3">
                    Pick standardized qualification attributes from your library. Candidates will be auto-matched against these requirements.
                </p>

                <!-- Requirements Counter Summary -->
                <div class="p-2 mb-3 rounded bg-surface-subtle border d-flex justify-content-around text-center">
                    <div>
                        <div class="fw-bold fs-5 text-danger">@selectedAttributes.Count(a => a.IsRequired)</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Mandatory</div>
                    </div>
                    <div class="border-start"></div>
                    <div>
                        <div class="fw-bold fs-5 text-primary">@selectedAttributes.Count(a => !a.IsRequired)</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Optional</div>
                    </div>
                    <div class="border-start"></div>
                    <div>
                        <div class="fw-bold fs-5 text-body">@selectedAttributes.Count</div>
                        <div class="text-muted" style="font-size: 0.7rem;">Total Selected</div>
                    </div>
                </div>

                <!-- Attributes List Grouped by Category -->
                <div style="max-height: 480px; overflow-y: auto;" class="pe-1">
                    @foreach (var cat in categories)
                    {
                        var catAttrs = allAttributes.Where(a => a.CategoryId == cat.Id).ToList();
                        if (catAttrs.Count > 0)
                        {
                            <div class="mb-3">
                                <div class="fw-semibold small text-body mb-2 d-flex align-items-center">
                                    <i class="bi bi-folder2-open text-primary me-1"></i> @cat.Name
                                </div>

                                <div class="d-flex flex-column gap-2">
                                    @foreach (var attr in catAttrs)
                                    {
                                        var isSelected = selectedAttributes.Any(a => a.AttributeId == attr.Id);
                                        var currentConfig = selectedAttributes.FirstOrDefault(a => a.AttributeId == attr.Id);

                                        <div class="p-2 rounded border @(isSelected ? "border-primary bg-primary-subtle bg-opacity-10" : "bg-surface")">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <div class="form-check m-0">
                                                    <input class="form-check-input" type="checkbox" id="attr_@attr.Id"
                                                           checked="@isSelected"
                                                           @onchange="(e) => ToggleAttributeSelection(attr, (bool)e.Value!)" />
                                                    <label class="form-check-label fw-semibold small" for="attr_@attr.Id">
                                                        @attr.Name
                                                    </label>
                                                </div>

                                                <span class="badge-type @GetBadgeClass(attr.DataType)" style="font-size: 0.65rem;">
                                                    @attr.DataType
                                                </span>
                                            </div>

                                            @if (isSelected && currentConfig != null)
                                            {
                                                <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                                                    <div class="btn-group btn-group-sm">
                                                        <button type="button" 
                                                                class="btn @(currentConfig.IsRequired ? "btn-danger" : "btn-outline-custom") py-0 px-2" 
                                                                style="font-size: 0.7rem;"
                                                                @onclick="() => currentConfig.IsRequired = true">
                                                            <i class="bi bi-asterisk me-1"></i> Required
                                                        </button>
                                                        <button type="button" 
                                                                class="btn @(!currentConfig.IsRequired ? "btn-primary" : "btn-outline-custom") py-0 px-2" 
                                                                style="font-size: 0.7rem;"
                                                                @onclick="() => currentConfig.IsRequired = false">
                                                            Optional
                                                        </button>
                                                    </div>

                                                    <span class="text-muted" style="font-size: 0.68rem;">
                                                        @(currentConfig.IsRequired ? "Must be answered in CV" : "Preferred qualification")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private Position positionModel = new()
    {
        EmploymentType = EmploymentType.FullTime,
        Visibility = PositionVisibility.Public
    };

    private List<AttributeCategory> categories = new();
    private List<CvAttribute> allAttributes = new();
    private List<PositionAttributeInput> selectedAttributes = new();

    private string? errorMessage;
    private string currentUserId = "demo-recruiter-id";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "demo-recruiter-id";
        }

        categories = await AttributeService.GetCategoriesAsync();
        allAttributes = await AttributeService.GetAttributesAsync();

        if (Id.HasValue && Id.Value > 0)
        {
            var existing = await PositionService.GetPositionByIdAsync(Id.Value);
            if (existing != null)
            {
                positionModel = new Position
                {
                    Id = existing.Id,
                    Title = existing.Title,
                    Company = existing.Company,
                    Location = existing.Location,
                    Description = existing.Description,
                    EmploymentType = existing.EmploymentType,
                    Visibility = existing.Visibility,
                    Deadline = existing.Deadline,
                    Tags = existing.Tags,
                    RecruiterId = existing.RecruiterId,
                    CreatedAt = existing.CreatedAt
                };

                selectedAttributes = existing.PositionAttributes.Select(pa => new PositionAttributeInput
                {
                    AttributeId = pa.AttributeId,
                    IsRequired = pa.IsRequired,
                    DisplayOrder = pa.DisplayOrder
                }).ToList();
            }
        }
        else
        {
            // Default template: pre-select attributes marked as IsRequiredDefault
            int order = 1;
            foreach (var attr in allAttributes.Where(a => a.IsRequiredDefault))
            {
                selectedAttributes.Add(new PositionAttributeInput
                {
                    AttributeId = attr.Id,
                    IsRequired = true,
                    DisplayOrder = order++
                });
            }
        }
    }

    private void ToggleAttributeSelection(CvAttribute attr, bool isSelected)
    {
        if (isSelected)
        {
            if (!selectedAttributes.Any(a => a.AttributeId == attr.Id))
            {
                selectedAttributes.Add(new PositionAttributeInput
                {
                    AttributeId = attr.Id,
                    IsRequired = attr.IsRequiredDefault,
                    DisplayOrder = selectedAttributes.Count + 1
                });
            }
        }
        else
        {
            selectedAttributes.RemoveAll(a => a.AttributeId == attr.Id);
        }
    }

    private async Task SavePosition()
    {
        if (string.IsNullOrWhiteSpace(positionModel.Title) ||
            string.IsNullOrWhiteSpace(positionModel.Company) ||
            string.IsNullOrWhiteSpace(positionModel.Location) ||
            string.IsNullOrWhiteSpace(positionModel.Description))
        {
            errorMessage = "Please fill in Title, Company, Location, and Description.";
            return;
        }

        if (selectedAttributes.Count == 0)
        {
            errorMessage = "Please select at least one qualification attribute for this position template.";
            return;
        }

        await PositionService.SavePositionAsync(positionModel, selectedAttributes, currentUserId);
        NavigationManager.NavigateTo("recruiter/positions");
    }

    private string GetBadgeClass(AttributeDataType type) => type switch
    {
        AttributeDataType.Text => "badge-type-text",
        AttributeDataType.LongText => "badge-type-longtext",
        AttributeDataType.Number => "badge-type-number",
        AttributeDataType.Date => "badge-type-date",
        AttributeDataType.Boolean => "badge-type-boolean",
        AttributeDataType.Dropdown => "badge-type-dropdown",
        AttributeDataType.MultiSelect => "badge-type-multiselect",
        AttributeDataType.Url => "badge-type-url",
        _ => "badge-type-text"
    };
}
