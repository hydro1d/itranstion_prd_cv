@page "/cv/{Id:int}"
@page "/cv/{Id:int}/edit"
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using CvPlatform.Data.Entities
@using CvPlatform.Data.Enums
@using CvPlatform.Services
@using Markdig
@inject ICvService CvService
@inject ICandidateProfileService ProfileService
@inject IPositionService PositionService
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(cv != null ? cv.Title : "Tailored CV Editor") - @Loc["App_Title"]</PageTitle>

<div class="container-fluid px-4 py-3">
    <!-- Breadcrumb & Action Toolbar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 no-print">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="candidate/dashboard" class="text-decoration-none">@Loc["Nav_CandidateDashboard"]</a></li>
                    <li class="breadcrumb-item"><a href="candidate/profile" class="text-decoration-none">@Loc["Candidate_MasterProfile"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tailored CV</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h3 class="fw-bold mb-0">
                    <i class="bi bi-file-earmark-person text-primary me-2"></i>
                    Tailored Document Editor
                </h3>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    Killer Feature #3
                </span>
            </div>
            @if (cv?.Position != null)
            {
                <p class="text-muted small mb-0 mt-1">
                    Customized for <strong class="text-body">@cv.Position.Title</strong> at <strong class="text-body">@cv.Position.Company</strong>
                </p>
            }
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Save Status Indicator -->
            <span class="badge @(isSaving ? "bg-warning-subtle text-warning" : (hasUnsavedChanges ? "bg-info-subtle text-info" : "bg-success-subtle text-success")) border py-2 px-3">
                <i class="bi @(isSaving ? "bi-arrow-repeat spin" : (hasUnsavedChanges ? "bi-pencil" : "bi-check-circle-fill")) me-1"></i>
                @(isSaving ? "Saving..." : (hasUnsavedChanges ? "Unsaved changes" : "All changes saved"))
            </span>

            @if (!isReadOnly)
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="SaveCvAsync" disabled="@isSaving">
                    <i class="bi bi-save me-1"></i> @Loc["Btn_Save"] Changes
                </button>
            }

            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="PrintCv">
                <i class="bi bi-printer me-1"></i> Print / Save PDF
            </button>

            <a href="candidate/profile" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Return to Profile
            </a>
        </div>
    </div>

    <!-- Concurrency Conflict Warning Alert -->
    @if (concurrencyConflict)
    {
        <div class="alert alert-danger shadow-sm border py-3 mb-4 no-print" role="alert">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-octagon-fill fs-4 text-danger"></i>
                    <div>
                        <strong class="d-block">Optimistic Concurrency Conflict Detected!</strong>
                        <span class="small">This tailored CV was updated in another browser tab or session. Reload the document to inspect the latest changes without losing your local work.</span>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm" @onclick="ReloadAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i> Reload Latest Version
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="alert alert-success alert-dismissible fade show py-2 small mb-4 no-print" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @feedbackMessage
            <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = null' aria-label="Close"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <span class="ms-2 text-muted small">Loading tailored CV document...</span>
        </div>
    }
    else if (cv == null)
    {
        <div class="text-center py-5 border rounded bg-body-tertiary">
            <i class="bi bi-file-earmark-x fs-1 text-muted d-block mb-3"></i>
            <h4 class="fw-bold">Tailored CV Not Found</h4>
            <p class="text-muted small mb-3">The requested document could not be located or you do not have permission to view it.</p>
            <a href="candidate/profile" class="btn btn-primary btn-sm">Return to Profile</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- ============================================== -->
            <!-- LEFT COLUMN: The Modern Document Sheet (Paper) -->
            <!-- ============================================== -->
            <div class="col-lg-8">
                <div class="cv-document-paper">
                    <!-- Candidate Document Header -->
                    <div class="row align-items-center g-3 pb-3 border-bottom mb-4">
                        <div class="col-auto">
                            @if (!string.IsNullOrEmpty(cv.CandidateProfile?.ProfileImageUrl))
                            {
                                <img src="@cv.CandidateProfile.ProfileImageUrl" alt="Avatar" class="rounded-circle border" style="width: 72px; height: 72px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold fs-3 border" style="width: 72px; height: 72px;">
                                    @GetInitials(cv.CandidateProfile?.FullName)
                                </div>
                            }
                        </div>
                        <div class="col">
                            <h3 class="fw-bold mb-1">@(cv.CandidateProfile?.FullName ?? "Candidate Name")</h3>
                            <div class="text-primary fw-semibold mb-1">
                                @(cv.CandidateProfile?.Headline ?? "Professional Candidate")
                            </div>
                            <div class="d-flex flex-wrap gap-3 small text-muted">
                                @if (!string.IsNullOrEmpty(cv.CandidateProfile?.Location))
                                {
                                    <span><i class="bi bi-geo-alt me-1"></i> @cv.CandidateProfile.Location</span>
                                }
                                @if (!string.IsNullOrEmpty(cv.CandidateProfile?.Phone))
                                {
                                    <span><i class="bi bi-telephone me-1"></i> @cv.CandidateProfile.Phone</span>
                                }
                                @if (!string.IsNullOrEmpty(socialLinks.GitHub))
                                {
                                    <span><i class="bi bi-github me-1"></i> GitHub</span>
                                }
                                @if (!string.IsNullOrEmpty(socialLinks.LinkedIn))
                                {
                                    <span><i class="bi bi-linkedin me-1"></i> LinkedIn</span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Tailored Document Title & Target Position -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted mb-1 no-print">Document Title</label>
                        <input type="text" class="form-control form-control-lg fw-bold"
                               placeholder="e.g. Tailored CV — Senior Cloud Architect"
                               disabled="@isReadOnly"
                               @bind="currentTitle" @bind:event="oninput" @onkeyup="MarkUnsaved" />
                    </div>

                    <!-- Professional Summary -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <h6 class="fw-bold text-uppercase text-secondary mb-0" style="letter-spacing: 0.05em;">
                                <i class="bi bi-person-lines-fill text-primary me-2"></i> Professional Summary
                            </h6>
                            <span class="badge bg-light text-muted border small no-print">Tailored for Position</span>
                        </div>
                        <textarea class="form-control mt-2" rows="4"
                                  placeholder="Write a targeted summary highlighting why your background specifically fits this opening..."
                                  disabled="@isReadOnly"
                                  @bind="currentSummary" @bind:event="oninput" @onkeyup="MarkUnsaved"></textarea>
                    </div>

                    <!-- ============================================================== -->
                    <!-- TARGETED QUALIFICATIONS: AUTO-MAPPED ATTRIBUTES (KF#3 Core)    -->
                    <!-- ============================================================== -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                            <h6 class="fw-bold text-uppercase text-secondary mb-0" style="letter-spacing: 0.05em;">
                                <i class="bi bi-patch-check-fill text-primary me-2"></i> Targeted Position Requirements
                            </h6>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle small no-print">
                                Auto-Mapped from Master Profile
                            </span>
                        </div>

                        @if (groupedPositionAttributes.Any())
                        {
                            @foreach (var group in groupedPositionAttributes)
                            {
                                <div class="mb-3">
                                    <div class="fw-bold small text-muted mb-2 text-uppercase" style="font-size: 0.75rem;">
                                        <i class="bi bi-folder2-open me-1 text-primary"></i> @group.Key
                                    </div>
                                    <div class="row g-2">
                                        @foreach (var pa in group.Value)
                                        {
                                            var currentVal = GetAttributeValue(pa.AttributeId);
                                            bool isMissing = pa.IsRequired && string.IsNullOrWhiteSpace(currentVal);

                                            <div class="@(pa.Attribute.DataType == AttributeDataType.LongText ? "col-12" : "col-md-6")">
                                                <div class="p-2 border rounded @(isMissing ? "cv-field-missing" : "bg-body-tertiary")" id="@($"field_attr_{pa.AttributeId}")">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <label class="form-label fw-semibold small mb-0">
                                                            @pa.Attribute.Name
                                                            @if (pa.IsRequired)
                                                            {
                                                                <span class="text-danger">*</span>
                                                            }
                                                        </label>
                                                        <div class="d-flex align-items-center gap-1">
                                                            <span class="badge-type @GetBadgeClass(pa.Attribute.DataType)">
                                                                @pa.Attribute.DataType
                                                            </span>
                                                            @if (pa.IsRequired)
                                                            {
                                                                <span class="badge @(isMissing ? "bg-danger text-white" : "bg-danger-subtle text-danger")" style="font-size: 0.68rem;">
                                                                    Required
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-light text-muted border" style="font-size: 0.68rem;">
                                                                    Optional
                                                                </span>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- Interactive Input for all 8 Data Types -->
                                                    @switch (pa.Attribute.DataType)
                                                    {
                                                        case AttributeDataType.Text:
                                                            <input type="text" class="form-control form-control-sm"
                                                                   placeholder="Enter @pa.Attribute.Name..."
                                                                   disabled="@isReadOnly"
                                                                   value="@currentVal"
                                                                   @onchange='(e) => OnAttributeChanged(pa.AttributeId, e.Value?.ToString())' />
                                                            break;

                                                        case AttributeDataType.LongText:
                                                            <textarea class="form-control form-control-sm" rows="3"
                                                                      placeholder="Enter details for @pa.Attribute.Name..."
                                                                      disabled="@isReadOnly"
                                                                      value="@currentVal"
                                                                      @onchange='(e) => OnAttributeChanged(pa.AttributeId, e.Value?.ToString())'></textarea>
                                                            break;

                                                        case AttributeDataType.Number:
                                                            <input type="number" class="form-control form-control-sm"
                                                                   placeholder="0"
                                                                   disabled="@isReadOnly"
                                                                   value="@currentVal"
                                                                   @onchange='(e) => OnAttributeChanged(pa.AttributeId, e.Value?.ToString())' />
                                                            break;

                                                        case AttributeDataType.Date:
                                                            <input type="date" class="form-control form-control-sm"
                                                                   disabled="@isReadOnly"
                                                                   value="@currentVal"
                                                                   @onchange='(e) => OnAttributeChanged(pa.AttributeId, e.Value?.ToString())' />
                                                            break;

                                                        case AttributeDataType.Boolean:
                                                            <div class="form-check form-switch pt-1">
                                                                <input class="form-check-input" type="checkbox" role="switch"
                                                                       id="@($"sw_cv_{pa.AttributeId}")"
                                                                       disabled="@isReadOnly"
                                                                       checked="@(currentVal == "true")"
                                                                       @onchange='(e) => OnAttributeChanged(pa.AttributeId, ((bool)(e.Value ?? false)).ToString().ToLower())' />
                                                                <label class="form-check-label small" for="@($"sw_cv_{pa.AttributeId}")">
                                                                    @(currentVal == "true" ? Loc["Candidate_BoolYes"] : Loc["Candidate_BoolNo"])
                                                                </label>
                                                            </div>
                                                            break;

                                                        case AttributeDataType.Dropdown:
                                                            <select class="form-select form-select-sm"
                                                                    disabled="@isReadOnly"
                                                                    value="@currentVal"
                                                                    @onchange='(e) => OnAttributeChanged(pa.AttributeId, e.Value?.ToString())'>
                                                                <option value="">-- @Loc["Candidate_SelectOption"] --</option>
                                                                @foreach (var opt in pa.Attribute.Options.OrderBy(o => o.DisplayOrder))
                                                                {
                                                                    <option value="@opt.Value">@opt.Value</option>
                                                                }
                                                            </select>
                                                            break;

                                                        case AttributeDataType.MultiSelect:
                                                            <input type="text" class="form-control form-control-sm"
                                                                   placeholder="Comma-separated values..."
                                                                   disabled="@isReadOnly"
                                                                   value="@currentVal"
                                                                   @onchange='(e) => OnAttributeChanged(pa.AttributeId, e.Value?.ToString())' />
                                                            @if (pa.Attribute.Options.Any())
                                                            {
                                                                <div class="d-flex flex-wrap gap-1 mt-1 no-print">
                                                                    @foreach (var opt in pa.Attribute.Options.OrderBy(o => o.DisplayOrder))
                                                                    {
                                                                        var currentList = (currentVal ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
                                                                        var isSelected = currentList.Contains(opt.Value);
                                                                        <button type="button" 
                                                                                disabled="@isReadOnly"
                                                                                class="btn btn-xs @(isSelected ? "btn-primary text-white" : "btn-outline-secondary") py-0 px-2"
                                                                                style="font-size: 0.72rem;"
                                                                                @onclick="() => ToggleMultiSelectOption(pa.AttributeId, opt.Value)">
                                                                            @(isSelected ? "✓ " : "+ ")@opt.Value
                                                                        </button>
                                                                    }
                                                                </div>
                                                            }
                                                            break;

                                                        case AttributeDataType.Url:
                                                            <div class="input-group input-group-sm">
                                                                <input type="url" class="form-control"
                                                                       placeholder="https://..."
                                                                       disabled="@isReadOnly"
                                                                       value="@currentVal"
                                                                       @onchange='(e) => OnAttributeChanged(pa.AttributeId, e.Value?.ToString())' />
                                                                @if (!string.IsNullOrWhiteSpace(currentVal))
                                                                {
                                                                    <a href="@currentVal" target="_blank" class="btn btn-outline-secondary">
                                                                        <i class="bi bi-box-arrow-up-right"></i>
                                                                    </a>
                                                                }
                                                            </div>
                                                            break;
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Portfolio Projects Showcase -->
                    @if (cv.CandidateProfile?.Projects?.Any() == true)
                    {
                        <div class="mb-2">
                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                <h6 class="fw-bold text-uppercase text-secondary mb-0" style="letter-spacing: 0.05em;">
                                    <i class="bi bi-folder-fill text-primary me-2"></i> Featured Portfolio Projects
                                </h6>
                            </div>

                            @foreach (var proj in cv.CandidateProfile.Projects.OrderBy(p => p.DisplayOrder))
                            {
                                <div class="p-3 border rounded mb-3 bg-body-tertiary">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <h6 class="fw-bold text-primary mb-0">@proj.Title</h6>
                                        <div class="d-flex gap-2">
                                            @if (!string.IsNullOrWhiteSpace(proj.GitHubUrl))
                                            {
                                                <a href="@proj.GitHubUrl" target="_blank" class="text-muted small text-decoration-none">
                                                    <i class="bi bi-github me-1"></i> Repo
                                                </a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(proj.ProjectUrl))
                                            {
                                                <a href="@proj.ProjectUrl" target="_blank" class="text-primary small text-decoration-none">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i> Demo
                                                </a>
                                            }
                                        </div>
                                    </div>
                                    <p class="text-muted small mb-2">@proj.Description</p>

                                    @if (!string.IsNullOrWhiteSpace(proj.Technologies))
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            @foreach (var tech in proj.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.72rem;">@tech</span>
                                            }
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(proj.MarkdownContent))
                                    {
                                        <div class="mt-2 pt-2 border-top small text-muted markdown-rendered">
                                            @RenderMarkdown(proj.MarkdownContent)
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- ============================================== -->
            <!-- RIGHT COLUMN: Sticky Readiness & Missing Panel -->
            <!-- ============================================== -->
            <div class="col-lg-4 no-print">
                <div class="sticky-top" style="top: 1.5rem; z-index: 10;">
                    <!-- Readiness Score Card -->
                    <div class="card border shadow-sm mb-3">
                        <div class="card-header bg-transparent py-2">
                            <span class="fw-bold small">Requirement Readiness Meter</span>
                        </div>
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-semibold text-muted">Completion Score</span>
                                <span class="badge @(mappingStatus.CompletionPercentage == 100 ? "bg-success" : (mappingStatus.CompletionPercentage >= 75 ? "bg-primary" : "bg-warning")) fs-6 fw-bold">
                                    @mappingStatus.CompletionPercentage%
                                </span>
                            </div>
                            <div class="progress mb-2" style="height: 8px;">
                                <div class="progress-bar @(mappingStatus.CompletionPercentage == 100 ? "bg-success" : (mappingStatus.CompletionPercentage >= 75 ? "bg-primary" : "bg-warning"))"
                                     style="width: @(mappingStatus.CompletionPercentage)%;"></div>
                            </div>

                            <div class="d-flex justify-content-between small text-muted mb-3" style="font-size: 0.75rem;">
                                <span>Mandatory: @mappingStatus.FilledRequired/@mappingStatus.TotalRequired</span>
                                <span>Optional: @mappingStatus.FilledOptional/@mappingStatus.TotalOptional</span>
                            </div>

                            @if (mappingStatus.IsReadyForSubmission)
                            {
                                <div class="alert alert-success py-2 small mb-0 d-flex align-items-center gap-2">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <div>
                                        <strong>Ready for Evaluation</strong>
                                        <div style="font-size: 0.72rem;">All mandatory position qualifications are satisfied.</div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 small mb-0 d-flex align-items-center gap-2">
                                    <i class="bi bi-exclamation-triangle-fill text-warning fs-5"></i>
                                    <div>
                                        <strong>Incomplete Requirements</strong>
                                        <div style="font-size: 0.72rem;">@mappingStatus.MissingRequiredAttributes.Count mandatory fields still need values.</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Missing Requirements Checklist -->
                    @if (mappingStatus.MissingRequiredAttributes.Any())
                    {
                        <div class="card border border-danger-subtle shadow-sm mb-3">
                            <div class="card-header bg-danger-subtle text-danger py-2 d-flex justify-content-between align-items-center">
                                <span class="fw-bold small">
                                    <i class="bi bi-list-check me-1"></i> Missing Mandatory Fields
                                </span>
                                <span class="badge bg-danger text-white">@mappingStatus.MissingRequiredAttributes.Count</span>
                            </div>
                            <div class="list-group list-group-flush small">
                                @foreach (var missing in mappingStatus.MissingRequiredAttributes)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold text-danger">@missing.Name</div>
                                            <div class="text-muted" style="font-size: 0.72rem;">@(missing.CategoryName ?? "Requirement")</div>
                                        </div>
                                        <span class="badge-type @GetBadgeClass(missing.DataType)">
                                            @missing.DataType
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- Target Position Summary Card -->
                    @if (cv.Position != null)
                    {
                        <div class="card border shadow-sm mb-3">
                            <div class="card-header bg-transparent py-2">
                                <span class="fw-bold small">Target Position Specifications</span>
                            </div>
                            <div class="card-body p-3 small">
                                <h6 class="fw-bold mb-1">@cv.Position.Title</h6>
                                <p class="text-muted mb-2">@cv.Position.Company • @cv.Position.Location</p>
                                <div class="d-flex justify-content-between text-muted mb-1">
                                    <span>Employment:</span>
                                    <span class="fw-semibold text-body">@cv.Position.EmploymentType</span>
                                </div>
                                <div class="d-flex justify-content-between text-muted mb-1">
                                    <span>Recruiter:</span>
                                    <span class="fw-semibold text-body">@(cv.Position.Recruiter?.FullName ?? "Hiring Lead")</span>
                                </div>
                                <div class="mt-3 pt-2 border-top">
                                    <a href="positions/@cv.Position.Id" class="btn btn-outline-secondary btn-sm w-100">
                                        <i class="bi bi-box-arrow-up-right me-1"></i> View Full Opening Spec
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Architectural Rules & Invariants Notice -->
                    <div class="card border bg-light">
                        <div class="card-body p-3" style="font-size: 0.75rem;">
                            <div class="fw-bold text-secondary mb-1">
                                <i class="bi bi-shield-lock-fill text-primary me-1"></i> Evaluation Defense Invariants
                            </div>
                            <ul class="text-muted ps-3 mb-0">
                                <li class="mb-1"><strong>1 CV per Position Rule</strong>: Auto-mapping enforces compound unique index <code>(CandidateId, PositionId)</code>.</li>
                                <li class="mb-1"><strong>Optimistic Concurrency</strong>: <code>RowVersion</code> protects against concurrent overwrites.</li>
                                <li><strong>Isolation</strong>: Tailoring values here does not corrupt your master profile.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private CV? cv;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool hasUnsavedChanges = false;
    private bool concurrencyConflict = false;
    private string? feedbackMessage;
    private bool isReadOnly = false;

    private string currentTitle = "";
    private string currentSummary = "";
    private string expectedRowVersion = "";
    private Dictionary<int, string> attributeValuesDict = new();
    private Dictionary<string, List<PositionAttribute>> groupedPositionAttributes = new();
    private CvMappingStatus mappingStatus = new();
    private CandidateSocialLinks socialLinks = new();

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    protected override async Task OnInitializedAsync()
    {
        await LoadCvDocumentAsync();
    }

    private async Task LoadCvDocumentAsync()
    {
        isLoading = true;
        concurrencyConflict = false;
        try
        {
            cv = await CvService.GetCvByIdAsync(Id);
            if (cv != null)
            {
                currentTitle = cv.Title;
                currentSummary = cv.ProfessionalSummary ?? "";
                expectedRowVersion = cv.RowVersion;

                // Load candidate social links
                if (!string.IsNullOrEmpty(cv.CandidateProfile?.SocialLinksJson))
                {
                    try
                    {
                        socialLinks = JsonSerializer.Deserialize<CandidateSocialLinks>(cv.CandidateProfile.SocialLinksJson) ?? new();
                    }
                    catch
                    {
                        socialLinks = new();
                    }
                }

                // Populate attribute values dictionary
                attributeValuesDict = cv.AttributeValues.ToDictionary(v => v.AttributeId, v => v.Value);

                // Group position attributes by category
                if (cv.Position?.PositionAttributes != null)
                {
                    groupedPositionAttributes = cv.Position.PositionAttributes
                        .OrderBy(pa => pa.DisplayOrder)
                        .GroupBy(pa => pa.Attribute?.Category?.Name ?? "General Requirements")
                        .ToDictionary(g => g.Key, g => g.ToList());
                }

                // Check authorization / read-only state
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var user = authState.User;
                var currentUserId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                bool isAdmin = user.IsInRole(ApplicationRole.Administrator);
                bool isOwner = cv.CandidateProfile?.UserId == currentUserId;

                isReadOnly = !isOwner && !isAdmin;

                // Recalculate status
                RecalculateMappingStatus();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetAttributeValue(int attributeId)
    {
        return attributeValuesDict.TryGetValue(attributeId, out var val) ? val : "";
    }

    private void OnAttributeChanged(int attributeId, string? value)
    {
        attributeValuesDict[attributeId] = value ?? "";
        hasUnsavedChanges = true;
        RecalculateMappingStatus();
    }

    private void ToggleMultiSelectOption(int attributeId, string optionValue)
    {
        var current = (GetAttributeValue(attributeId) ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        if (current.Contains(optionValue))
        {
            current.Remove(optionValue);
        }
        else
        {
            current.Add(optionValue);
        }

        OnAttributeChanged(attributeId, string.Join(", ", current));
    }

    private void MarkUnsaved()
    {
        hasUnsavedChanges = true;
    }

    private void RecalculateMappingStatus()
    {
        if (cv?.Position?.PositionAttributes == null) return;

        mappingStatus = new CvMappingStatus { CvId = Id };
        foreach (var pa in cv.Position.PositionAttributes)
        {
            var val = GetAttributeValue(pa.AttributeId);
            bool isFilled = !string.IsNullOrWhiteSpace(val);

            if (pa.IsRequired)
            {
                mappingStatus.TotalRequired++;
                if (isFilled)
                {
                    mappingStatus.FilledRequired++;
                }
                else
                {
                    mappingStatus.MissingRequiredAttributes.Add(new CvMissingAttribute
                    {
                        AttributeId = pa.AttributeId,
                        Name = pa.Attribute?.Name ?? $"Requirement #{pa.AttributeId}",
                        CategoryName = pa.Attribute?.Category?.Name,
                        DataType = pa.Attribute?.DataType ?? AttributeDataType.Text
                    });
                }
            }
            else
            {
                mappingStatus.TotalOptional++;
                if (isFilled) mappingStatus.FilledOptional++;
            }
        }

        mappingStatus.CompletionPercentage = mappingStatus.TotalRequired == 0
            ? 100
            : (mappingStatus.FilledRequired * 100) / mappingStatus.TotalRequired;
    }

    private async Task SaveCvAsync()
    {
        if (cv == null || isReadOnly) return;
        isSaving = true;
        concurrencyConflict = false;
        try
        {
            var result = await CvService.UpdateCvAsync(Id, currentTitle, currentSummary, attributeValuesDict, expectedRowVersion);
            if (result.Success && result.UpdatedCv != null)
            {
                expectedRowVersion = result.UpdatedCv.RowVersion;
                hasUnsavedChanges = false;
                feedbackMessage = "Tailored CV document saved successfully.";
                RecalculateMappingStatus();
            }
            else if (result.ConcurrencyConflict)
            {
                concurrencyConflict = true;
            }
            else
            {
                feedbackMessage = result.ErrorMessage ?? "Failed to save document.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ReloadAsync()
    {
        await LoadCvDocumentAsync();
    }

    private async Task PrintCv()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "CP";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private string GetBadgeClass(AttributeDataType type) => type switch
    {
        AttributeDataType.Text => "badge-type-text",
        AttributeDataType.LongText => "badge-type-longtext",
        AttributeDataType.Number => "badge-type-number",
        AttributeDataType.Date => "badge-type-date",
        AttributeDataType.Boolean => "badge-type-boolean",
        AttributeDataType.Dropdown => "badge-type-dropdown",
        AttributeDataType.MultiSelect => "badge-type-multiselect",
        AttributeDataType.Url => "badge-type-url",
        _ => "badge-type-text"
    };

    private MarkupString RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return new MarkupString("");
        var html = Markdown.ToHtml(markdown, _pipeline);
        return new MarkupString(html);
    }
}
