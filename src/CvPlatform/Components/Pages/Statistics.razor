@page "/statistics"

<PageTitle>Platform Statistics | CvPlatform</PageTitle>

<div class="mb-4">
    <h1 class="fw-bold mb-1">Platform Metrics & Insights</h1>
    <p class="text-muted mb-0">Overview of active recruitment flows, attribute reuse rates, and generated CVs.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="app-surface p-3">
            <span class="text-muted small fw-semibold text-uppercase">Total Positions</span>
            <div class="fs-3 fw-bold mt-1">24</div>
            <div class="text-success small mt-1"><i class="bi bi-arrow-up-right me-1"></i>100% Published</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-surface p-3">
            <span class="text-muted small fw-semibold text-uppercase">Candidates Enrolled</span>
            <div class="fs-3 fw-bold mt-1">148</div>
            <div class="text-muted small mt-1"><i class="bi bi-people me-1"></i>Verified Profiles</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-surface p-3">
            <span class="text-muted small fw-semibold text-uppercase">Reusable Attributes</span>
            <div class="fs-3 fw-bold mt-1">64</div>
            <div class="text-primary small mt-1"><i class="bi bi-sliders me-1"></i>Library Items</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="app-surface p-3">
            <span class="text-muted small fw-semibold text-uppercase">CVs Tailored</span>
            <div class="fs-3 fw-bold mt-1">310</div>
            <div class="text-info small mt-1"><i class="bi bi-cpu me-1"></i>Auto-Mapped</div>
        </div>
    </div>
</div>

<div class="app-surface p-4">
    <h5 class="fw-semibold mb-3">System Architecture & Health</h5>
    <div class="row g-3 text-muted small">
        <div class="col-sm-6 col-md-3">
            <div class="fw-medium text-body">Backend Runtime</div>
            <div>.NET 9 / ASP.NET Core</div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="fw-medium text-body">Database Engine</div>
            <div>PostgreSQL + EF Core</div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="fw-medium text-body">UI Framework</div>
            <div>Blazor Interactive Server</div>
        </div>
        <div class="col-sm-6 col-md-3">
            <div class="fw-medium text-body">Design System</div>
            <div>Custom Slate Dual-Theme</div>
        </div>
    </div>
</div>
