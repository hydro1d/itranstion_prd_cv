@page "/candidate/profile"
@attribute [Authorize(Roles = $"{ApplicationRole.Candidate},{ApplicationRole.Administrator}")]
@using System.Text.Json
@using CvPlatform.Data.Entities
@using CvPlatform.Data.Enums
@using CvPlatform.Services
@using Markdig
@inject ICandidateProfileService ProfileService
@inject IAttributeService AttributeService
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Navigation

<PageTitle>@Loc["Candidate_ProfileTitle"] - @Loc["App_Title"]</PageTitle>

<div class="mb-4">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="candidate/dashboard" class="text-decoration-none">@Loc["Nav_CandidateDashboard"]</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Loc["Candidate_MasterProfile"]</li>
                </ol>
            </nav>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold mb-0">@Loc["Candidate_MasterProfile"]</h2>
                <span class="badge bg-primary-subtle text-primary">
                    <i class="bi bi-person-vcard me-1"></i> Single Source of Truth
                </span>
            </div>
            <p class="text-muted small mb-0 mt-1">
                @Loc["Candidate_ProfileSubtitle"]
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @(isSaving ? "bg-warning-subtle text-warning border" : "bg-success-subtle text-success border") py-2 px-3">
                <i class="bi @(isSaving ? "bi-arrow-repeat spin" : "bi-check2-circle") me-1"></i>
                @(isSaving ? Loc["Candidate_SavingStatus"] : Loc["Candidate_SavedStatus"])
            </span>
            <a href="positions" class="btn btn-outline-custom btn-sm">
                <i class="bi bi-briefcase me-1"></i> @Loc["Candidate_ExploreOpenings"]
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading profile...</span>
            </div>
        </div>
    }
    else if (profile != null)
    {
        <!-- Profile Banner & Readiness Score Card -->
        <div class="app-surface p-4 mb-4">
            <div class="row align-items-center g-4">
                <div class="col-auto">
                    @if (!string.IsNullOrEmpty(profile.ProfileImageUrl))
                    {
                        <img src="@profile.ProfileImageUrl" alt="@profile.FullName" class="rounded-circle border" style="width: 76px; height: 76px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="avatar-circle avatar-lg" style="width: 76px; height: 76px; font-size: 1.6rem;">
                            @GetInitials(profile.FullName)
                        </div>
                    }
                </div>
                <div class="col">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                        <h4 class="fw-bold mb-0">@profile.FullName</h4>
                        @if (!string.IsNullOrEmpty(profile.Location))
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">
                                <i class="bi bi-geo-alt me-1"></i> @profile.Location
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(profile.Phone))
                        {
                            <span class="badge bg-secondary-subtle text-secondary border">
                                <i class="bi bi-telephone me-1"></i> @profile.Phone
                            </span>
                        }
                    </div>
                    <p class="text-primary fw-semibold mb-2">
                        @(profile.Headline ?? "Add a professional headline")
                    </p>
                    <div class="d-flex flex-wrap gap-3 small text-muted">
                        @if (!string.IsNullOrEmpty(socialLinks.GitHub))
                        {
                            <a href="@socialLinks.GitHub" target="_blank" class="text-decoration-none text-muted">
                                <i class="bi bi-github me-1"></i> GitHub
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(socialLinks.LinkedIn))
                        {
                            <a href="@socialLinks.LinkedIn" target="_blank" class="text-decoration-none text-muted">
                                <i class="bi bi-linkedin me-1"></i> LinkedIn
                            </a>
                        }
                        @if (!string.IsNullOrEmpty(socialLinks.Portfolio))
                        {
                            <a href="@socialLinks.Portfolio" target="_blank" class="text-decoration-none text-muted">
                                <i class="bi bi-globe me-1"></i> Portfolio
                            </a>
                        }
                    </div>
                </div>
                <div class="col-md-4 border-start ps-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-semibold text-muted text-uppercase" style="font-size: 0.7rem; letter-spacing: 0.05em;">@Loc["Candidate_ReadinessScore"]</span>
                        <span class="badge @(readiness.Percentage >= 80 ? "bg-success" : "bg-warning") text-white fw-bold">
                            @readiness.Percentage%
                        </span>
                    </div>
                    <div class="progress mb-2" style="height: 6px; border-radius: 3px; background-color: var(--app-border);">
                        <div class="progress-bar @(readiness.Percentage >= 80 ? "bg-success" : "bg-warning")" 
                             style="width: @(readiness.Percentage)%;"></div>
                    </div>
                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.72rem;">
                        <span>Me: @readiness.PersonalDetailsScore/40</span>
                        <span>Info: @readiness.AttributesScore/40</span>
                        <span>Projects: @readiness.ProjectsScore/20</span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
            <div class="alert alert-success alert-dismissible fade show py-2 small mb-4" role="alert">
                <i class="bi bi-check2-circle me-1"></i> @feedbackMessage
                <button type="button" class="btn-close py-2" @onclick='() => feedbackMessage = null' aria-label="Close"></button>
            </div>
        }

        <!-- 4 PRD Sections Navigation -->
        <div class="app-surface">
            <div class="border-bottom p-0">
                <ul class="nav nav-tabs border-0 px-3 pt-2">
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "me" ? "active fw-bold text-primary" : "text-muted")"
                                @onclick='() => activeTab = "me"'>
                            <i class="bi bi-person me-2"></i> 1. @Loc["Candidate_TabMe"]
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "info" ? "active fw-bold text-primary" : "text-muted")"
                                @onclick='() => activeTab = "info"'>
                            <i class="bi bi-sliders2 me-2"></i> 2. @Loc["Candidate_TabInfo"]
                            <span class="badge bg-secondary-subtle text-secondary ms-1">@attributeValuesDict.Count</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "projects" ? "active fw-bold text-primary" : "text-muted")"
                                @onclick='() => activeTab = "projects"'>
                            <i class="bi bi-folder2-open me-2"></i> 3. @Loc["Candidate_TabProjects"]
                            <span class="badge bg-secondary-subtle text-secondary ms-1">@projects.Count</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == "cvs" ? "active fw-bold text-primary" : "text-muted")"
                                @onclick='() => activeTab = "cvs"'>
                            <i class="bi bi-file-earmark-person me-2"></i> 4. @Loc["Candidate_TabCvs"]
                            <span class="badge bg-secondary-subtle text-secondary ms-1">@candidateCvs.Count</span>
                        </button>
                    </li>
                </ul>
            </div>

            <div class="card-body p-4">
                <!-- ========================================== -->
                <!-- SECTION 1: "ME" (Personal details & links) -->
                <!-- ========================================== -->
                @if (activeTab == "me")
                {
                    <div class="row g-4">
                        <div class="col-lg-8">
                            <h5 class="fw-bold mb-3 d-flex align-items-center">
                                <i class="bi bi-person-badge text-primary me-2"></i>
                                @Loc["Candidate_PersonalDetailsTitle"]
                            </h5>
                            
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        @Loc["Candidate_FullName"] <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" @bind="profile.FullName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        @Loc["Candidate_Headline"] <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" placeholder="e.g. Senior Full-Stack & Cloud Systems Architect"
                                           @bind="profile.Headline" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold small mb-1">
                                    @Loc["Candidate_ProfessionalSummary"] <span class="text-danger">*</span>
                                </label>
                                <textarea class="form-control" rows="4" 
                                          placeholder="A compelling high-level summary of your engineering experience, capabilities, and key achievements..."
                                          @bind="profile.Summary"></textarea>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        <i class="bi bi-telephone me-1"></i> @Loc["Candidate_Phone"]
                                    </label>
                                    <input type="tel" class="form-control" placeholder="+1 (555) 000-0000"
                                           @bind="profile.Phone" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        <i class="bi bi-geo-alt me-1"></i> @Loc["Candidate_Location"]
                                    </label>
                                    <input type="text" class="form-control" placeholder="e.g. Stockholm, Sweden / Remote"
                                           @bind="profile.Location" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold small mb-1">
                                    <i class="bi bi-image me-1"></i> @Loc["Candidate_ProfileImageUrl"]
                                </label>
                                <input type="url" class="form-control" placeholder="https://example.com/avatar.jpg"
                                       @bind="profile.ProfileImageUrl" />
                            </div>

                            <h5 class="fw-bold mb-3 d-flex align-items-center border-top pt-3">
                                <i class="bi bi-share text-primary me-2"></i>
                                @Loc["Candidate_SocialPresence"]
                            </h5>

                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        <i class="bi bi-github me-1"></i> GitHub URL
                                    </label>
                                    <input type="url" class="form-control" placeholder="https://github.com/username"
                                           @bind="socialLinks.GitHub" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        <i class="bi bi-linkedin me-1"></i> LinkedIn URL
                                    </label>
                                    <input type="url" class="form-control" placeholder="https://linkedin.com/in/username"
                                           @bind="socialLinks.LinkedIn" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        <i class="bi bi-globe me-1"></i> Portfolio Website
                                    </label>
                                    <input type="url" class="form-control" placeholder="https://yourdomain.com"
                                           @bind="socialLinks.Portfolio" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold small mb-1">
                                        <i class="bi bi-twitter-x me-1"></i> Twitter / X URL
                                    </label>
                                    <input type="url" class="form-control" placeholder="https://x.com/username"
                                           @bind="socialLinks.Twitter" />
                                </div>
                            </div>

                            <button type="button" class="btn btn-primary" @onclick="SavePersonalDetailsAsync" disabled="@isSaving">
                                <i class="bi bi-check2-circle me-1"></i> @Loc["Candidate_SavePersonalDetails"]
                            </button>
                        </div>

                        <!-- Sidebar Tips -->
                        <div class="col-lg-4 border-start-lg">
                            <div class="p-3 bg-light rounded border mb-3">
                                <h6 class="fw-bold mb-2">
                                    <i class="bi bi-lightbulb text-warning me-1"></i> @Loc["Candidate_WhyMasterProfileTitle"]
                                </h6>
                                <p class="text-muted small mb-0">
                                    @Loc["Candidate_WhyMasterProfileDesc"]
                                </p>
                            </div>
                            <div class="card border">
                                <div class="card-header bg-transparent py-2">
                                    <span class="fw-semibold small">Readiness Checklist</span>
                                </div>
                                <div class="card-body p-3">
                                    <ul class="list-unstyled small text-muted mb-0">
                                        <li class="mb-2 d-flex align-items-center">
                                            <i class="bi @(!string.IsNullOrEmpty(profile.FullName) ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                                            Candidate Full Name
                                        </li>
                                        <li class="mb-2 d-flex align-items-center">
                                            <i class="bi @(!string.IsNullOrEmpty(profile.Headline) ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                                            Professional Headline
                                        </li>
                                        <li class="mb-2 d-flex align-items-center">
                                            <i class="bi @(!string.IsNullOrEmpty(profile.Summary) ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                                            Executive Summary
                                        </li>
                                        <li class="mb-2 d-flex align-items-center">
                                            <i class="bi @(!string.IsNullOrEmpty(profile.Location) ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                                            Geographic Location
                                        </li>
                                        <li class="d-flex align-items-center">
                                            <i class="bi @(!string.IsNullOrEmpty(socialLinks.GitHub) || !string.IsNullOrEmpty(socialLinks.LinkedIn) ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>
                                            Social Profile Links
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <!-- ============================================================== -->
                <!-- SECTION 2: "INFO" (Reusable Dynamic Library Attributes - KF#1) -->
                <!-- ============================================================== -->
                else if (activeTab == "info")
                {
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                        <div>
                            <h5 class="fw-bold mb-1">
                                <i class="bi bi-ui-checks text-primary me-2"></i>
                                @Loc["Candidate_InfoTitle"]
                            </h5>
                            <p class="text-muted small mb-0">
                                @Loc["Candidate_InfoSubtitle"]
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-primary btn-sm" @onclick="SaveAttributesAsync" disabled="@isSaving">
                                <i class="bi bi-save me-1"></i> @Loc["Candidate_SaveAllAttributes"]
                            </button>
                        </div>
                    </div>

                    <!-- Category Filter & Search Bar -->
                    <div class="row g-2 mb-4">
                        <div class="col-md-8">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-search text-muted"></i>
                                </span>
                                <input type="text" class="form-control border-start-0" 
                                       placeholder="Filter attributes by name or description..."
                                       @bind="attributeSearch" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" @bind="selectedCategoryFilter">
                                <option value="0">All Categories (@allCategories.Count)</option>
                                @foreach (var cat in allCategories)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- Grouped Dynamic Fields Accordion / Sections -->
                    @foreach (var cat in FilteredCategories())
                    {
                        var catAttributes = FilteredAttributesForCategory(cat.Id);
                        if (!catAttributes.Any()) continue;

                        <div class="card border mb-3">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                <span class="fw-bold small text-secondary">
                                    <i class="bi bi-folder2-open me-2 text-primary"></i>
                                    @cat.Name
                                </span>
                                <span class="badge bg-secondary-subtle text-secondary small">
                                    @catAttributes.Count attributes
                                </span>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    @foreach (var attr in catAttributes)
                                    {
                                        <div class="@(attr.DataType == AttributeDataType.LongText ? "col-12" : "col-md-6")">
                                            <div class="p-2 border rounded bg-body-tertiary">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <label class="form-label fw-semibold small mb-0">
                                                        @attr.Name
                                                    </label>
                                                    <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.7rem;">
                                                        @attr.DataType
                                                    </span>
                                                </div>
                                                
                                                @if (!string.IsNullOrEmpty(attr.Description))
                                                {
                                                    <p class="text-muted small mb-2" style="font-size: 0.75rem;">
                                                        @attr.Description
                                                    </p>
                                                }

                                                <!-- Specialized Form Control by DataType -->
                                                @switch (attr.DataType)
                                                {
                                                    case AttributeDataType.Text:
                                                        <input type="text" class="form-control form-control-sm"
                                                               placeholder="Enter @attr.Name..."
                                                               value="@GetAttributeValue(attr.Id)"
                                                               @onchange='(e) => SetAttributeValue(attr.Id, e.Value?.ToString())' />
                                                        break;

                                                    case AttributeDataType.LongText:
                                                        <textarea class="form-control form-control-sm" rows="3"
                                                                  placeholder="Enter details for @attr.Name..."
                                                                  value="@GetAttributeValue(attr.Id)"
                                                                  @onchange='(e) => SetAttributeValue(attr.Id, e.Value?.ToString())'></textarea>
                                                        break;

                                                    case AttributeDataType.Number:
                                                        <input type="number" class="form-control form-control-sm"
                                                               placeholder="0"
                                                               value="@GetAttributeValue(attr.Id)"
                                                               @onchange='(e) => SetAttributeValue(attr.Id, e.Value?.ToString())' />
                                                        break;

                                                    case AttributeDataType.Date:
                                                        <input type="date" class="form-control form-control-sm"
                                                               value="@GetAttributeValue(attr.Id)"
                                                               @onchange='(e) => SetAttributeValue(attr.Id, e.Value?.ToString())' />
                                                        break;

                                                    case AttributeDataType.Boolean:
                                                        <div class="form-check form-switch pt-1">
                                                            <input class="form-check-input" type="checkbox" role="switch"
                                                                   id="@($"switch_{attr.Id}")"
                                                                   checked="@(GetAttributeValue(attr.Id) == "true")"
                                                                   @onchange='(e) => SetAttributeValue(attr.Id, ((bool)(e.Value ?? false)).ToString().ToLower())' />
                                                            <label class="form-check-label small" for="@($"switch_{attr.Id}")">
                                                                @(GetAttributeValue(attr.Id) == "true" ? Loc["Candidate_BoolYes"] : Loc["Candidate_BoolNo"])
                                                            </label>
                                                        </div>
                                                        break;

                                                    case AttributeDataType.Dropdown:
                                                        <select class="form-select form-select-sm"
                                                                value="@GetAttributeValue(attr.Id)"
                                                                @onchange='(e) => SetAttributeValue(attr.Id, e.Value?.ToString())'>
                                                            <option value="">-- @Loc["Candidate_SelectOption"] --</option>
                                                            @foreach (var opt in attr.Options.OrderBy(o => o.DisplayOrder))
                                                            {
                                                                <option value="@opt.Value">@opt.Value</option>
                                                            }
                                                        </select>
                                                        break;

                                                    case AttributeDataType.MultiSelect:
                                                        <input type="text" class="form-control form-control-sm"
                                                               placeholder="Comma-separated values..."
                                                               value="@GetAttributeValue(attr.Id)"
                                                               @onchange='(e) => SetAttributeValue(attr.Id, e.Value?.ToString())' />
                                                        @if (attr.Options.Any())
                                                        {
                                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                                @foreach (var opt in attr.Options.OrderBy(o => o.DisplayOrder))
                                                                {
                                                                    var currentList = (GetAttributeValue(attr.Id) ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
                                                                    var isSelected = currentList.Contains(opt.Value);
                                                                    <button type="button" 
                                                                            class="btn btn-xs @(isSelected ? "btn-primary text-white" : "btn-outline-secondary") py-0 px-2"
                                                                            style="font-size: 0.72rem;"
                                                                            @onclick="() => ToggleMultiSelectOption(attr.Id, opt.Value)">
                                                                        @(isSelected ? "✓ " : "+ ")@opt.Value
                                                                    </button>
                                                                }
                                                            </div>
                                                        }
                                                        break;

                                                    case AttributeDataType.Url:
                                                        <div class="input-group input-group-sm">
                                                            <input type="url" class="form-control"
                                                                   placeholder="https://..."
                                                                   value="@GetAttributeValue(attr.Id)"
                                                                   @onchange='(e) => SetAttributeValue(attr.Id, e.Value?.ToString())' />
                                                            @if (!string.IsNullOrWhiteSpace(GetAttributeValue(attr.Id)))
                                                            {
                                                                <a href="@GetAttributeValue(attr.Id)" target="_blank" class="btn btn-outline-secondary">
                                                                    <i class="bi bi-box-arrow-up-right"></i>
                                                                </a>
                                                            }
                                                        </div>
                                                        break;
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-end mt-4">
                        <button type="button" class="btn btn-primary" @onclick="SaveAttributesAsync" disabled="@isSaving">
                            <i class="bi bi-check2-circle me-1"></i> @Loc["Candidate_SaveAllAttributes"]
                        </button>
                    </div>
                }

                <!-- ============================================================== -->
                <!-- SECTION 3: "PROJECTS" (Portfolio Showcase with Live Markdown)   -->
                <!-- ============================================================== -->
                else if (activeTab == "projects")
                {
                    <!-- Table-Centric Action Toolbar (Strict Evaluation Defense Requirement) -->
                    <div class="card border bg-light mb-3">
                        <div class="card-body py-2 px-3">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        <i class="bi bi-table me-1"></i> @projects.Count @Loc["Candidate_ProjectsCount"]
                                    </span>
                                    @if (selectedProjectId.HasValue)
                                    {
                                        <span class="badge bg-primary text-white">
                                            <i class="bi bi-check2-circle me-1"></i> Row Selected
                                        </span>
                                    }
                                </div>

                                <!-- Action Toolbar Buttons -->
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="OpenAddProjectModal">
                                        <i class="bi bi-plus-lg me-1"></i> @Loc["Candidate_AddProject"]
                                    </button>

                                    <button type="button" class="btn btn-outline-secondary btn-sm" 
                                            disabled="@(!selectedProjectId.HasValue)"
                                            @onclick="OpenEditProjectModal">
                                        <i class="bi bi-pencil me-1"></i> @Loc["Btn_Edit"]
                                    </button>

                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            disabled="@(!selectedProjectId.HasValue)"
                                            @onclick="OpenPreviewProjectModal">
                                        <i class="bi bi-markdown me-1"></i> @Loc["Candidate_PreviewMarkdown"]
                                    </button>

                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            disabled="@(!selectedProjectId.HasValue)"
                                            @onclick="DeleteSelectedProjectAsync">
                                        <i class="bi bi-trash me-1"></i> @Loc["Btn_Delete"]
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Projects Table (No Repeating Action Buttons Inside Rows) -->
                    @if (!projects.Any())
                    {
                        <div class="text-center py-5 border rounded bg-body-tertiary">
                            <i class="bi bi-folder-x fs-1 text-muted"></i>
                            <h6 class="fw-bold mt-2">@Loc["Candidate_NoProjectsTitle"]</h6>
                            <p class="text-muted small mb-3">@Loc["Candidate_NoProjectsDesc"]</p>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="OpenAddProjectModal">
                                <i class="bi bi-plus-lg me-1"></i> @Loc["Candidate_AddFirstProject"]
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive border rounded">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 40px;" class="text-center">#</th>
                                        <th>@Loc["Candidate_ProjectTitle"]</th>
                                        <th>@Loc["Candidate_Technologies"]</th>
                                        <th>Links</th>
                                        <th style="width: 90px;" class="text-center">Order</th>
                                        <th style="width: 140px;">Created</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var proj in projects)
                                    {
                                        var isSelected = selectedProjectId == proj.Id;
                                        <tr class="@(isSelected ? "table-active" : "")" style="cursor: pointer;"
                                            @onclick="() => SelectProject(proj.Id)">
                                            <td class="text-center">
                                                <input type="radio" name="projectSelectRadio" 
                                                       checked="@isSelected"
                                                       @onchange="() => SelectProject(proj.Id)" />
                                            </td>
                                            <td>
                                                <div class="fw-bold text-primary">@proj.Title</div>
                                                <div class="text-muted small text-truncate" style="max-width: 320px;">
                                                    @proj.Description
                                                </div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(proj.Technologies))
                                                {
                                                    <div class="d-flex flex-wrap gap-1">
                                                        @foreach (var t in proj.Technologies.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(4))
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary border" style="font-size: 0.72rem;">@t</span>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">—</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    @if (!string.IsNullOrWhiteSpace(proj.GitHubUrl))
                                                    {
                                                        <a href="@proj.GitHubUrl" target="_blank" class="text-decoration-none text-muted" title="GitHub Repository" @onclick:stopPropagation="true">
                                                            <i class="bi bi-github"></i>
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(proj.ProjectUrl))
                                                    {
                                                        <a href="@proj.ProjectUrl" target="_blank" class="text-decoration-none text-primary" title="Live Demo" @onclick:stopPropagation="true">
                                                            <i class="bi bi-box-arrow-up-right"></i>
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">@proj.DisplayOrder</span>
                                            </td>
                                            <td class="text-muted small">
                                                @proj.CreatedAt.ToString("MMM dd, yyyy")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Selected Project Markdown Preview Drawer/Card -->
                    @if (previewProject != null)
                    {
                        <div class="card border mt-4 shadow-sm">
                            <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                                <span class="fw-bold small">
                                    <i class="bi bi-markdown-fill text-primary me-2"></i>
                                    Markdown Preview: @previewProject.Title
                                </span>
                                <button type="button" class="btn-close" @onclick="() => previewProject = null" aria-label="Close"></button>
                            </div>
                            <div class="card-body p-4 bg-body-tertiary markdown-rendered">
                                @if (string.IsNullOrWhiteSpace(previewProject.MarkdownContent))
                                {
                                    <p class="text-muted small fst-italic mb-0">No markdown content recorded for this project.</p>
                                }
                                else
                                {
                                    @RenderMarkdown(previewProject.MarkdownContent)
                                }
                            </div>
                        </div>
                    }
                }

                <!-- ============================================================== -->
                <!-- SECTION 4: "CVS" (Tailored Applications Overview - KF#3)       -->
                <!-- ============================================================== -->
                else if (activeTab == "cvs")
                {
                    <div class="alert alert-info py-2 small mb-3 border d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill fs-5 text-info"></i>
                        <div>
                            <strong>Platform Invariant: Exactly 1 CV per Candidate per Position.</strong>
                            When applying to openings, your master profile attributes and selected projects are automatically mapped.
                        </div>
                    </div>

                    <!-- Table-Centric Action Toolbar & Responsive Table -->
                    <div class="table-responsive-wrapper mb-3">
                        <div class="table-toolbar">
                            <div class="table-toolbar-left">
                                <span class="badge bg-secondary-subtle text-secondary">
                                    <i class="bi bi-file-earmark-person me-1"></i> @candidateCvs.Count Tailored CVs
                                </span>
                                @if (selectedCvId.HasValue)
                                {
                                    <span class="badge bg-primary-subtle text-primary">
                                        <i class="bi bi-check2 me-1"></i> Selected
                                    </span>
                                }
                            </div>

                            <div class="table-toolbar-right">
                                <button type="button" class="btn btn-outline-custom btn-sm"
                                        disabled="@(!selectedCvId.HasValue)"
                                        @onclick="OpenSelectedCv">
                                    <i class="bi bi-pencil me-1"></i> Edit Tailored CV
                                </button>
                                <a href="positions" class="btn btn-primary btn-sm">
                                    <i class="bi bi-plus-lg me-1"></i> @Loc["Candidate_ApplyToPosition"]
                                </a>
                            </div>
                        </div>

                        <!-- CVs Table (No Repeating Action Buttons Inside Rows) -->
                        @if (!candidateCvs.Any())
                        {
                            <div class="app-empty-state">
                                <i class="bi bi-file-earmark-x app-empty-state-icon"></i>
                                <h6 class="app-empty-state-title">No Tailored CVs Yet</h6>
                                <p class="app-empty-state-description">Explore open positions and click 'Generate Tailored CV' to create your first application.</p>
                                <a href="positions" class="btn btn-primary btn-sm">
                                    <i class="bi bi-briefcase me-1"></i> Browse Open Positions
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="app-table">
                                    <thead>
                                        <tr>
                                            <th style="width: 40px;" class="text-center">#</th>
                                            <th>Tailored Document</th>
                                            <th>Target Position & Company</th>
                                            <th style="width: 130px;">Readiness</th>
                                            <th style="width: 100px;" class="text-center">Likes</th>
                                            <th style="width: 140px;">Created Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cv in candidateCvs)
                                        {
                                            var isSelected = selectedCvId == cv.Id;
                                            <tr class="@(isSelected ? "is-selected" : "")" style="cursor: pointer;"
                                                @onclick="() => selectedCvId = cv.Id">
                                                <td class="text-center" @onclick:stopPropagation="true">
                                                    <input type="radio" name="cvSelectRadio" 
                                                           checked="@isSelected"
                                                           class="table-selection-checkbox"
                                                           @onchange="() => selectedCvId = cv.Id" />
                                                </td>
                                            <td>
                                                <div class="fw-bold text-primary">@cv.Title</div>
                                                <div class="text-muted small text-truncate" style="max-width: 300px;">
                                                    @(cv.ProfessionalSummary ?? "Auto-generated tailored document")
                                                </div>
                                            </td>
                                            <td>
                                                @if (cv.Position != null)
                                                {
                                                    <div class="fw-semibold">@cv.Position.Title</div>
                                                    <div class="text-muted small">@cv.Position.Company • @cv.Position.Location</div>
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">General Position</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px;">
                                                        <div class="progress-bar @(cv.CompletionPercentage >= 90 ? "bg-success" : "bg-primary")" 
                                                             style="width: @(cv.CompletionPercentage)%;"></div>
                                                    </div>
                                                    <span class="small fw-bold">@cv.CompletionPercentage%</span>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-danger-subtle text-danger border">
                                                    <i class="bi bi-heart-fill me-1"></i> @(cv.Likes?.Count ?? 0)
                                                </span>
                                            </td>
                                            <td class="text-muted small">
                                                @cv.CreatedAt.ToString("MMM dd, yyyy")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- Project Editor Modal -->
<ProjectEditorModal IsOpen="@isProjectModalOpen"
                    Project="@currentEditingProject"
                    OnSave="SaveProjectModalAsync"
                    OnClose="CloseProjectModal" />

@code {
    private bool isLoading = true;
    private bool isSaving = false;
    private string activeTab = "me";
    private string? feedbackMessage;

    private CandidateProfile? profile;
    private CandidateSocialLinks socialLinks = new();
    private ProfileReadiness readiness = new();

    private List<CvAttribute> allAttributes = new();
    private List<AttributeCategory> allCategories = new();
    private Dictionary<int, string> attributeValuesDict = new();
    private string attributeSearch = "";
    private int selectedCategoryFilter = 0;

    private List<Project> projects = new();
    private int? selectedProjectId;
    private Project? previewProject;
    private bool isProjectModalOpen = false;
    private Project currentEditingProject = new();

    private List<CV> candidateCvs = new();
    private int? selectedCvId;

    private static readonly MarkdownPipeline _pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    protected override async Task OnInitializedAsync()
    {
        await LoadProfileDataAsync();
    }

    private async Task LoadProfileDataAsync()
    {
        isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "candidate-demo-user-id";

            profile = await ProfileService.GetProfileByUserIdAsync(userId);
            if (profile != null)
            {
                if (!string.IsNullOrEmpty(profile.SocialLinksJson))
                {
                    try
                    {
                        socialLinks = JsonSerializer.Deserialize<CandidateSocialLinks>(profile.SocialLinksJson) ?? new();
                    }
                    catch
                    {
                        socialLinks = new();
                    }
                }

                // Attributes & Categories
                allAttributes = await AttributeService.GetAttributesAsync();
                allCategories = await AttributeService.GetCategoriesAsync();
                
                var values = await ProfileService.GetAttributeValuesAsync(profile.Id);
                attributeValuesDict = values.ToDictionary(v => v.AttributeId, v => v.Value);

                // Projects
                projects = await ProfileService.GetProjectsAsync(profile.Id);

                // CVs
                candidateCvs = await ProfileService.GetCandidateCvsAsync(profile.Id);

                // Readiness
                readiness = await ProfileService.GetProfileReadinessAsync(profile.Id);
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "CP";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }

    private async Task SavePersonalDetailsAsync()
    {
        if (profile == null) return;
        isSaving = true;
        try
        {
            await ProfileService.SavePersonalDetailsAsync(profile.Id, profile, socialLinks);
            readiness = await ProfileService.GetProfileReadinessAsync(profile.Id);
            feedbackMessage = Loc["Candidate_PersonalSavedSuccess"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetAttributeValue(int attributeId)
    {
        return attributeValuesDict.TryGetValue(attributeId, out var val) ? val : "";
    }

    private void SetAttributeValue(int attributeId, string? value)
    {
        attributeValuesDict[attributeId] = value ?? "";
    }

    private void ToggleMultiSelectOption(int attributeId, string optionValue)
    {
        var current = (GetAttributeValue(attributeId) ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        if (current.Contains(optionValue))
        {
            current.Remove(optionValue);
        }
        else
        {
            current.Add(optionValue);
        }

        SetAttributeValue(attributeId, string.Join(", ", current));
    }

    private async Task SaveAttributesAsync()
    {
        if (profile == null) return;
        isSaving = true;
        try
        {
            await ProfileService.SaveAttributeValuesAsync(profile.Id, attributeValuesDict);
            readiness = await ProfileService.GetProfileReadinessAsync(profile.Id);
            feedbackMessage = Loc["Candidate_AttributesSavedSuccess"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private IEnumerable<AttributeCategory> FilteredCategories()
    {
        if (selectedCategoryFilter > 0)
        {
            return allCategories.Where(c => c.Id == selectedCategoryFilter);
        }
        return allCategories;
    }

    private List<CvAttribute> FilteredAttributesForCategory(int categoryId)
    {
        var query = allAttributes.Where(a => a.CategoryId == categoryId);
        if (!string.IsNullOrWhiteSpace(attributeSearch))
        {
            query = query.Where(a => a.Name.Contains(attributeSearch, StringComparison.OrdinalIgnoreCase) ||
                                     (a.Description != null && a.Description.Contains(attributeSearch, StringComparison.OrdinalIgnoreCase)));
        }
        return query.OrderBy(a => a.Id).ToList();
    }

    private void SelectProject(int id)
    {
        selectedProjectId = id;
        previewProject = null;
    }

    private void OpenAddProjectModal()
    {
        currentEditingProject = new Project
        {
            DisplayOrder = projects.Count > 0 ? projects.Max(p => p.DisplayOrder) + 1 : 1
        };
        isProjectModalOpen = true;
    }

    private void OpenEditProjectModal()
    {
        if (!selectedProjectId.HasValue) return;
        var p = projects.FirstOrDefault(x => x.Id == selectedProjectId.Value);
        if (p == null) return;

        currentEditingProject = new Project
        {
            Id = p.Id,
            CandidateProfileId = p.CandidateProfileId,
            Title = p.Title,
            Description = p.Description,
            MarkdownContent = p.MarkdownContent,
            Technologies = p.Technologies,
            GitHubUrl = p.GitHubUrl,
            ProjectUrl = p.ProjectUrl,
            DisplayOrder = p.DisplayOrder,
            CreatedAt = p.CreatedAt
        };
        isProjectModalOpen = true;
    }

    private void OpenPreviewProjectModal()
    {
        if (!selectedProjectId.HasValue) return;
        previewProject = projects.FirstOrDefault(p => p.Id == selectedProjectId.Value);
    }

    private async Task DeleteSelectedProjectAsync()
    {
        if (!selectedProjectId.HasValue || profile == null) return;
        isSaving = true;
        try
        {
            await ProfileService.DeleteProjectAsync(profile.Id, selectedProjectId.Value);
            projects = await ProfileService.GetProjectsAsync(profile.Id);
            selectedProjectId = null;
            previewProject = null;
            readiness = await ProfileService.GetProfileReadinessAsync(profile.Id);
            feedbackMessage = Loc["Candidate_ProjectDeletedSuccess"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveProjectModalAsync(Project savedProject)
    {
        if (profile == null) return;
        isSaving = true;
        try
        {
            await ProfileService.SaveProjectAsync(profile.Id, savedProject);
            projects = await ProfileService.GetProjectsAsync(profile.Id);
            isProjectModalOpen = false;
            readiness = await ProfileService.GetProfileReadinessAsync(profile.Id);
            feedbackMessage = Loc["Candidate_ProjectSavedSuccess"];
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CloseProjectModal()
    {
        isProjectModalOpen = false;
    }

    private MarkupString RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return new MarkupString("");
        var html = Markdown.ToHtml(markdown, _pipeline);
        return new MarkupString(html);
    }

    private void OpenSelectedCv()
    {
        if (selectedCvId.HasValue)
        {
            Navigation.NavigateTo($"/cv/{selectedCvId.Value}");
        }
    }
}
