@page "/"
@inject IPositionService PositionService
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager NavigationManager

<PageTitle>@Loc["Page_Title"] | @Loc["App_Title"]</PageTitle>

<!-- Introduction: Concise, Focused, Human-Designed -->
<div class="mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="mb-1 fw-bold">@Loc["Hero_Title"]</h1>
            <p class="text-muted mb-0" style="font-size: 0.95rem;">
                @Loc["Hero_Subtitle"]
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="candidate/profile" class="btn btn-outline-custom btn-sm">
                <i class="bi bi-person-lines-fill"></i>
                <span>@Loc["Btn_ManageProfile"]</span>
            </a>
            <a href="recruiter/positions" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg"></i>
                <span>@Loc["Btn_PostOpportunity"]</span>
            </a>
        </div>
    </div>
</div>

<!-- Dynamic Platform Metrics -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="app-surface p-3">
            <div class="text-muted small fw-medium text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">@Loc["Metric_ActivePositions"]</div>
            <div class="d-flex align-items-baseline justify-content-between">
                <span class="fs-4 fw-bold">@metrics.ActivePositions</span>
                <span class="badge bg-primary-subtle text-primary" style="font-size: 0.7rem;">Live</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="app-surface p-3">
            <div class="text-muted small fw-medium text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">@Loc["Metric_RegisteredCandidates"]</div>
            <div class="d-flex align-items-baseline justify-content-between">
                <span class="fs-4 fw-bold">@metrics.RegisteredCandidates</span>
                <span class="badge bg-success-subtle text-success" style="font-size: 0.7rem;">Active</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="app-surface p-3">
            <div class="text-muted small fw-medium text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">@Loc["Metric_PartnerRecruiters"]</div>
            <div class="d-flex align-items-baseline justify-content-between">
                <span class="fs-4 fw-bold">@metrics.PartnerRecruiters</span>
                <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.7rem;">Verified</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="app-surface p-3">
            <div class="text-muted small fw-medium text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.05em;">@Loc["Metric_CvsGenerated"]</div>
            <div class="d-flex align-items-baseline justify-content-between">
                <span class="fs-4 fw-bold">@metrics.CvsGenerated</span>
                <span class="badge bg-info-subtle text-info" style="font-size: 0.7rem;">Automated</span>
            </div>
        </div>
    </div>
</div>

<!-- Main Section: Latest Positions (Table-Centric Design) -->
<div class="table-responsive-wrapper mb-4">
    <!-- Action Toolbar (Driven by Selection, No Repeating In-Row Action Buttons) -->
    <div class="table-toolbar">
        <div class="table-toolbar-left">
            <div class="app-search-input">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control form-control-sm" placeholder="@Loc["Search_Positions_Placeholder"]" @bind="searchQuery" @bind:event="oninput" />
            </div>
            <select class="form-select form-select-sm" style="max-width: 170px;" @bind="selectedType">
                <option value="">@Loc["Filter_AllEmployment"]</option>
                <option value="FullTime">@Loc["Employment_FullTime"]</option>
                <option value="Contract">@Loc["Employment_Contract"]</option>
                <option value="Remote">@Loc["Employment_Remote"]</option>
                <option value="Internship">Internship</option>
            </select>
        </div>

        <div class="table-toolbar-right">
            @if (selectedPositionId.HasValue)
            {
                <span class="text-muted small me-2">@Loc["Position_Selected_Hint"]</span>
                <a href="positions/@selectedPositionId.Value" class="btn btn-outline-custom btn-sm">
                    <i class="bi bi-box-arrow-up-right me-1"></i>
                    <span>View Opening</span>
                </a>
                <button class="btn btn-outline-custom btn-sm" @onclick="ClearSelection">
                    <i class="bi bi-x"></i>
                    <span>@Loc["Btn_Deselect"]</span>
                </button>
                <a href="positions/@selectedPositionId.Value" class="btn btn-primary btn-sm">
                    <i class="bi bi-lightning-charge-fill"></i>
                    <span>@Loc["Btn_GenerateCv"]</span>
                </a>
            }
            else
            {
                <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>@Loc["Select_Row_Hint"]</span>
            }
        </div>
    </div>

    <!-- Table -->
    <div class="table-responsive">
        <table class="app-table">
            <thead>
                <tr>
                    <th style="width: 40px;" class="text-center">#</th>
                    <th>@Loc["Th_PositionTitle"]</th>
                    <th>@Loc["Th_Company"]</th>
                    <th>@Loc["Th_EmploymentType"]</th>
                    <th>@Loc["Th_Location"]</th>
                    <th>Required Qualifications</th>
                    <th>@Loc["Th_Posted"]</th>
                    <th class="text-end">Applications</th>
                </tr>
            </thead>
            <tbody>
                @if (FilteredPositions.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center py-4 text-muted">
                            No open positions match your search filter.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var pos in FilteredPositions)
                    {
                        var isSelected = selectedPositionId == pos.Id;
                        var reqCount = pos.PositionAttributes.Count(pa => pa.IsRequired);

                        <tr class="@(isSelected ? "is-selected" : "")" style="cursor: pointer;" @onclick="() => SelectPosition(pos.Id)">
                            <td class="text-center" @onclick:stopPropagation="true">
                                <input type="radio" name="selectedPos" checked="@isSelected" class="table-selection-checkbox" @onchange="() => SelectPosition(pos.Id)" />
                            </td>
                            <td>
                                <div class="fw-semibold">@pos.Title</div>
                                @if (!string.IsNullOrEmpty(pos.Tags))
                                {
                                    <div class="text-muted small">@pos.Tags</div>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-building text-muted"></i>
                                    <span>@pos.Company</span>
                                </div>
                            </td>
                            <td>
                                <span class="badge @(pos.EmploymentType == EmploymentType.Remote ? "badge-status-published" : "badge-tag")">
                                    @pos.EmploymentType
                                </span>
                            </td>
                            <td><i class="bi bi-geo-alt text-muted me-1"></i>@pos.Location</td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap align-items-center">
                                    <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">
                                        @reqCount Mandatory
                                    </span>
                                    <span class="text-muted small" style="font-size: 0.7rem;">
                                        (@pos.PositionAttributes.Count total)
                                    </span>
                                </div>
                            </td>
                            <td class="text-muted small">@pos.CreatedAt.ToString("MMM dd")</td>
                            <td class="text-end fw-semibold">@(pos.CVs?.Count ?? 0)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Footer -->
    <div class="table-pagination">
        <span>Showing @FilteredPositions.Count of @livePositions.Count positions</span>
        <div class="d-flex gap-1">
            <button class="btn btn-outline-custom btn-sm" disabled><i class="bi bi-chevron-left"></i></button>
            <button class="btn btn-outline-custom btn-sm" disabled><i class="bi bi-chevron-right"></i></button>
        </div>
    </div>
</div>

<!-- Subtle Tag Cloud (PRD Section 9) -->
<div class="app-surface p-3">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <h6 class="mb-0 fw-semibold text-muted text-uppercase" style="font-size: 0.75rem; letter-spacing: 0.05em;">@Loc["Popular_Tags"]</h6>
        <span class="text-muted small">@Loc["Click_To_Filter"]</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var tag in popularTags)
        {
            <button class="btn btn-sm @(searchQuery == tag ? "btn-primary" : "btn-outline-custom")" @onclick="() => FilterByTag(tag)">
                <i class="bi bi-tag-fill me-1" style="font-size: 0.75rem;"></i>
                @tag
            </button>
        }
        @if (!string.IsNullOrEmpty(searchQuery))
        {
            <button class="btn btn-ghost btn-sm text-danger" @onclick="() => searchQuery = string.Empty">
                <i class="bi bi-x-circle me-1"></i>@Loc["Btn_ResetFilter"]
            </button>
        }
    </div>
</div>

@code {
    private string searchQuery = string.Empty;
    private string selectedType = string.Empty;
    private int? selectedPositionId = null;

    private List<Position> livePositions = new();
    private PlatformMetrics metrics = new()
    {
        ActivePositions = 4,
        RegisteredCandidates = 148,
        PartnerRecruiters = 12,
        CvsGenerated = 310
    };

    private readonly List<string> popularTags = new()
    {
        ".NET 9", "C#", "Blazor", "Cloud", "Microservices", "Architecture", "Docker", "Kubernetes", "TypeScript", "React"
    };

    protected override async Task OnInitializedAsync()
    {
        livePositions = await PositionService.GetPositionsAsync(visibility: PositionVisibility.Public);
        metrics = await PositionService.GetMetricsAsync();
    }

    private List<Position> FilteredPositions => livePositions
        .Where(p => string.IsNullOrWhiteSpace(searchQuery) ||
                    p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    p.Company.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrEmpty(p.Tags) && p.Tags.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .Where(p => string.IsNullOrWhiteSpace(selectedType) || p.EmploymentType.ToString() == selectedType)
        .ToList();

    private void SelectPosition(int id)
    {
        selectedPositionId = selectedPositionId == id ? null : id;
    }

    private void ClearSelection()
    {
        selectedPositionId = null;
    }

    private void FilterByTag(string tag)
    {
        searchQuery = searchQuery == tag ? string.Empty : tag;
    }
}
