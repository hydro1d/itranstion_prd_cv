@page "/account/register"
@page "/register"
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["Btn_Register"] - @Loc["App_Title"]</PageTitle>

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="app-surface p-4">
                <div class="text-center mb-4">
                    <span class="badge bg-primary-subtle text-primary mb-2 px-3 py-1">
                        <i class="bi bi-shield-check me-1"></i> @Loc["Auth_PortalTitle"]
                    </span>
                    <h3 class="fw-bold mb-1">@Loc["Auth_RegisterHeader"]</h3>
                    <p class="text-muted small">@Loc["Auth_RegisterSubheader"]</p>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle me-2 fs-5"></i>
                        <div class="small">
                            @GetErrorMessage(error)
                        </div>
                    </div>
                }

                <form method="post" action="/account/register">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="regFullName">@Loc["Auth_FullNameLabel"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input type="text" id="regFullName" name="fullName" class="form-control" placeholder="Jane Doe" required autofocus />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold" for="regEmail">@Loc["Auth_EmailLabel"]</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" id="regEmail" name="email" class="form-control" placeholder="jane@example.com" required />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-sm-6">
                            <label class="form-label small fw-semibold" for="regPassword">@Loc["Auth_PasswordLabel"]</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" id="regPassword" name="password" class="form-control" placeholder="••••••••" required />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label small fw-semibold" for="regConfirmPassword">@Loc["Auth_ConfirmPasswordLabel"]</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-check2"></i></span>
                                <input type="password" id="regConfirmPassword" name="confirmPassword" class="form-control" placeholder="••••••••" required />
                            </div>
                        </div>
                    </div>

                    <!-- Role Selection -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">@Loc["Auth_SelectRoleLabel"]</label>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <div class="p-3 role-select-card h-100 position-relative">
                                    <div class="form-check m-0">
                                        <input class="form-check-input" type="radio" name="role" id="roleCandidate" value="Candidate" checked />
                                        <label class="form-check-label fw-semibold small stretched-link" for="roleCandidate">
                                            <i class="bi bi-person-vcard text-success me-1"></i> @Loc["Role_Candidate"]
                                        </label>
                                    </div>
                                    <div class="text-muted ms-4 mt-1" style="font-size: 0.75rem; line-height: 1.35;">
                                        @Loc["Role_CandidateDesc"]
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-3 role-select-card h-100 position-relative">
                                    <div class="form-check m-0">
                                        <input class="form-check-input" type="radio" name="role" id="roleRecruiter" value="Recruiter" />
                                        <label class="form-check-label fw-semibold small stretched-link" for="roleRecruiter">
                                            <i class="bi bi-briefcase text-primary me-1"></i> @Loc["Role_Recruiter"]
                                        </label>
                                    </div>
                                    <div class="text-muted ms-4 mt-1" style="font-size: 0.75rem; line-height: 1.35;">
                                        @Loc["Role_RecruiterDesc"]
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3" style="min-height: 38px;">
                        <i class="bi bi-person-plus me-1.5"></i> @Loc["Btn_CreateAccount"]
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <span class="text-muted small">@Loc["Auth_AlreadyHaveAccountPrompt"]</span>
                    <a href="account/login" class="fw-semibold small text-primary ms-1">@Loc["Btn_SignIn"]</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? error { get; set; }

    private string GetErrorMessage(string errorCode) => errorCode switch
    {
        "MissingFields" => Loc["Auth_ErrorMissingFields"],
        "PasswordMismatch" => Loc["Auth_ErrorPasswordMismatch"],
        "EmailTaken" => Loc["Auth_ErrorEmailTaken"],
        _ => errorCode
    };
}
