@page "/search"

<PageTitle>Explore & Search | CvPlatform</PageTitle>

<div class="mb-4">
    <h1 class="fw-bold mb-1">Search & Directory</h1>
    <p class="text-muted mb-0">Search across positions, candidate skill tags, and reusable attribute definitions.</p>
</div>

<div class="app-surface p-4 mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-md-8">
            <div class="app-search-input" style="max-width: 100%;">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control" placeholder="Type keywords, skills, titles, or company names..." @bind="term" />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button class="btn btn-primary w-100"><i class="bi bi-search"></i> Execute Search</button>
        </div>
    </div>
</div>

<div class="app-surface">
    <div class="app-empty-state">
        <i class="bi bi-search app-empty-state-icon"></i>
        <div class="app-empty-state-title">No search executed yet</div>
        <div class="app-empty-state-description">Enter a search keyword above to query opportunities and profile attributes. Full PostgreSQL full-text search indexing is enabled in Phase 11.</div>
    </div>
</div>

@code {
    private string term = string.Empty;
}
