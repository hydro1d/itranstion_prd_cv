@inject IJSRuntime JSRuntime

<button class="btn btn-outline-custom btn-sm d-inline-flex align-items-center gap-1.5" @onclick="ToggleTheme" title="Toggle Light/Dark Theme" aria-label="Toggle theme">
    @if (isDark)
    {
        <i class="bi bi-moon-stars-fill text-warning"></i>
        <span class="d-none d-md-inline">Dark</span>
    }
    else
    {
        <i class="bi bi-sun-fill text-secondary"></i>
        <span class="d-none d-md-inline">Light</span>
    }
</button>

@code {
    private bool isDark = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JSRuntime.InvokeAsync<string>("ThemeManager.getTheme");
                isDark = theme == "dark";
                StateHasChanged();
            }
            catch
            {
                // Fallback for SSR pre-rendering
            }
        }
    }

    private async Task ToggleTheme()
    {
        try
        {
            var newTheme = await JSRuntime.InvokeAsync<string>("ThemeManager.toggleTheme");
            isDark = newTheme == "dark";
        }
        catch
        {
            isDark = !isDark;
        }
    }
}
