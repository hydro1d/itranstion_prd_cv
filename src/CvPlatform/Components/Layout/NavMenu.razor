@inject IStringLocalizer<SharedResource> Loc

<div class="app-sidebar-nav">
    <!-- Public Section (Always Available) -->
    <div class="nav-section-title">@Loc["Nav_PublicPortal"]</div>
    <NavLink class="app-nav-link" href="" Match="NavLinkMatch.All">
        <i class="bi bi-briefcase"></i>
        <span>@Loc["Nav_Positions"]</span>
    </NavLink>
    <NavLink class="app-nav-link" href="search">
        <i class="bi bi-search"></i>
        <span>@Loc["Nav_Search"]</span>
    </NavLink>
    <NavLink class="app-nav-link" href="statistics">
        <i class="bi bi-graph-up"></i>
        <span>@Loc["Nav_Statistics"]</span>
    </NavLink>

    <!-- Candidate Portal (Candidates & Admins) -->
    <AuthorizeView Roles="@($"{ApplicationRole.Candidate},{ApplicationRole.Administrator}")">
        <Authorized>
            <div class="nav-section-title">@Loc["Nav_CandidateSpace"]</div>
            <NavLink class="app-nav-link" href="candidate/dashboard">
                <i class="bi bi-columns-gap"></i>
                <span>@Loc["Nav_CandidateDashboard"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="candidate/profile">
                <i class="bi bi-person-vcard"></i>
                <span>@Loc["Nav_CandidateProfile"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="candidate/cvs">
                <i class="bi bi-file-earmark-text"></i>
                <span>@Loc["Nav_CandidateCvs"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="discussions">
                <i class="bi bi-chat-dots"></i>
                <span>@Loc["Nav_Discussions"]</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <!-- Recruiter Portal (Recruiters & Admins) -->
    <AuthorizeView Roles="@($"{ApplicationRole.Recruiter},{ApplicationRole.Administrator}")">
        <Authorized>
            <div class="nav-section-title">@Loc["Nav_RecruiterWorkspace"]</div>
            <NavLink class="app-nav-link" href="recruiter/dashboard">
                <i class="bi bi-clipboard2-check"></i>
                <span>@Loc["Nav_RecruiterDashboard"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="recruiter/positions">
                <i class="bi bi-folder2-open"></i>
                <span>@Loc["Nav_ManagePositions"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="recruiter/attributes">
                <i class="bi bi-sliders2"></i>
                <span>@Loc["Nav_AttributeLibrary"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="recruiter/cvs">
                <i class="bi bi-person-check"></i>
                <span>@Loc["Nav_ReviewCvs"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="discussions">
                <i class="bi bi-chat-dots"></i>
                <span>@Loc["Nav_Discussions"]</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <!-- Admin Portal (Strictly Administrators) -->
    <AuthorizeView Roles="@ApplicationRole.Administrator">
        <Authorized>
            <div class="nav-section-title">@Loc["Nav_Administration"]</div>
            <NavLink class="app-nav-link" href="admin/dashboard">
                <i class="bi bi-shield-check"></i>
                <span>@Loc["Nav_AdminDashboard"]</span>
            </NavLink>
            <NavLink class="app-nav-link" href="admin/users">
                <i class="bi bi-people"></i>
                <span>@Loc["Nav_AdminUsers"]</span>
            </NavLink>
        </Authorized>
    </AuthorizeView>

    <!-- Guest Prompt -->
    <AuthorizeView>
        <NotAuthorized>
            <div class="px-2 py-3 mt-3 border-top">
                <div class="p-3 rounded bg-surface-subtle border text-center">
                    <div class="small fw-semibold mb-1 text-body">Role Workspaces</div>
                    <div class="text-muted mb-3" style="font-size: 0.72rem; line-height: 1.4;">Sign in to access candidate profile, generator, and recruiter tools</div>
                    <a href="account/login" class="btn btn-primary btn-sm w-100 py-1" style="font-size: 0.78rem;">
                        <i class="bi bi-box-arrow-in-right me-1"></i> @Loc["Btn_SignIn"]
                    </a>
                </div>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<div class="app-sidebar-footer">
    <div class="d-flex align-items-center justify-content-between">
        <span class="d-flex align-items-center text-muted" style="font-size: 0.75rem;">
            <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.45rem;"></i> .NET 9 + Postgres
        </span>
        <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">v1.0</span>
    </div>
</div>
